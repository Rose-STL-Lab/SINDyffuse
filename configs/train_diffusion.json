{
  "seed": 42,
  "distributed": {
    "enabled": "auto",
    "backend": "nccl",
    "find_unused_parameters": false
  },
  "data": {
    "dataset": "lai",
    "data_root": "datasets/HumanML3D",
    "window_size": 64,
    "fps": 20,
    "normalize": true,
    "preload": true
  },
  "model": {
    "model_dim": 512,
    "num_layers": 8,
    "num_heads": 8,
    "dropout": 0.1,
    "clip_dim": 512,
    "clip_model_name": "ViT-B/32",
    "timesteps": 1000
  },
  "train": {
    "device": "auto",
    "batch_size": 8,
    "num_workers": 0,
    "lr": 0.0002,
    "weight_decay": 0.01,
    "max_steps": 100000,
    "log_every": 100,
    "save_every": 5000,
    "grad_clip": 1.0,
    "cond_drop_prob": 0.1,
    "guidance": "sindy",
    "lambda_sindy": 0.1,
    "lambda_opensim": 0.1,
    "sindy_checkpoint_dir": "results/sindy/latest",
    "surrogate_checkpoint_dir": "results/activation_surrogate/latest",
    "opensim_guidance": {
      "time_reduce": "mean",
      "foot_height_weight": 1.0,
      "velocity_smooth_weight": 0.1,
      "max_physics_frames": 64,
      "physics_on_cpu": true
    }
  }
}
