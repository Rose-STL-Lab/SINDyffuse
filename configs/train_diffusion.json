{
  "seed": 42,
  "distributed": {
    "enabled": "auto",
    "backend": "nccl",
    "find_unused_parameters": false
  },
  "data": {
    "dataset": "nimble",
    "data_root": "datasets/HumanML3D",
    "window_size": 64,
    "fps": 20,
    "normalize": true,
    "preload": true
  },
  "model": {
    "model_dim": 512,
    "num_layers": 8,
    "num_heads": 8,
    "dropout": 0.1,
    "clip_dim": 512,
    "clip_model_name": "ViT-B/32",
    "timesteps": 1000
  },
  "train": {
    "device": "auto",
    "batch_size": 8,
    "num_workers": 0,
    "lr": 0.0002,
    "weight_decay": 0.01,
    "max_steps": 100000,
    "log_every": 100,
    "save_every": 5000,
    "grad_clip": 1.0,
    "cond_drop_prob": 0.1,
    "guidance": "sindy",
    "lambda_sindy": 0.1,
    "lambda_nimble": 0.1,
    "sindy_checkpoint_dir": "results/sindy/latest",
    "surrogate_checkpoint_dir": "results/activation_surrogate/latest",
    "nimble_guidance": {
      "weights": {
        "lambda_contact": 0.05,
        "lambda_contact_wrench": 0.05,
        "lambda_grf_left": 0.05,
        "lambda_grf_right": 0.05,
        "lambda_grf_vertical": 0.05,
        "lambda_grf_weight_deficit": 0.05,
        "lambda_foot_slip": 0.05,
        "lambda_id_pelvis": 0.02,
        "lambda_id_hip_r": 0.02,
        "lambda_id_leg_r": 0.02,
        "lambda_id_hip_l": 0.02,
        "lambda_id_leg_l": 0.02,
        "lambda_id_lumbar": 0.02,
        "lambda_id_arm_r": 0.02,
        "lambda_id_arm_l": 0.02,
        "lambda_limit_pelvis_rot": 0.05,
        "lambda_limit_pelvis_trans": 0.05,
        "lambda_limit_hip_r": 0.05,
        "lambda_limit_leg_r": 0.05,
        "lambda_limit_hip_l": 0.05,
        "lambda_limit_leg_l": 0.05,
        "lambda_limit_lumbar": 0.05,
        "lambda_limit_arm_r": 0.05,
        "lambda_limit_arm_l": 0.05,
        "lambda_sym_hip_flex": 0.05,
        "lambda_sym_hip_add": 0.05,
        "lambda_sym_hip_rot": 0.05,
        "lambda_sym_knee": 0.05,
        "lambda_sym_ankle": 0.05,
        "lambda_sym_mtp": 0.05,
        "lambda_foot_clearance_l": 0.05,
        "lambda_foot_clearance_r": 0.05,
        "lambda_id_power_total": 0.02,
        "lambda_id_sym_hip": 0.02,
        "lambda_id_sym_knee": 0.02,
        "lambda_id_sym_ankle": 0.02,
        "lambda_grf_asymmetry": 0.05,
        "lambda_contact_power": 0.05,
        "lambda_limit_margin_min": 0.05,
        "lambda_support_width": 0.05
      },
      "physics": {
        "time_reduce": "mean",
        "robust": "huber",
        "huber_delta": 10.0,
        "charbonnier_eps": 0.001,
        "cvar_alpha": 0.1,
        "lse_temperature": 10.0,
        "t_weight_schedule": "linear",
        "smooth_poses": true,
        "smooth_cutoff_hz": 6.0,
        "smooth_butterworth_order": 2,
        "mass_kg": 70.0,
        "g_mps2": 9.81,
        "contact_height_thresh_m": 0.06,
        "contact_speed_thresh_mps": 1.2,
        "contact_gate_sharpness": 15.0,
        "max_physics_frames": 64,
        "fk_backend": "torch",
        "physics_on_cpu": false,
        "physics_batch_cap": 0
      }
    }
  }
}
