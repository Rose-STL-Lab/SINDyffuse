{
  "seed": 42,
  "data_root": "datasets/HumanML3D",
  "split": "train",
  "val_split": "val",
  "window_size": 64,
  "window_stride": 16,
  "normalize_q": 1,
  "max_motions": 0,
  "skip_zero_placeholders": 1,
  "model_type": "transformer",
  "hidden_dim": 512,
  "num_layers": 5,
  "dropout": 0.05,
  "num_heads": 8,
  "dim_feedforward": 512,
  "lr": 0.001,
  "weight_decay": 0.0001,
  "epochs": 50,
  "batch_size": 32,
  "lambda_temporal": 0.15,
  "device": "auto",
  "num_workers": 4
}
